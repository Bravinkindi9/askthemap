ATM_GEMINI_API_KEY=your-gemini-api-key-here

# Which VLM provider get_vlm() returns: "gemini" or "openrouter". Defaults to "gemini".
ATM_VLM_PROVIDER=gemini

# Only needed when ATM_VLM_PROVIDER=openrouter. Free, no card required: https://openrouter.ai/keys
ATM_OPENROUTER_API_KEY=your-openrouter-api-key-here
ATM_OPENROUTER_MODEL=qwen/qwen2.5-vl-7b-instruct:free
